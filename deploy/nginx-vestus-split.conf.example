# Nginx 由自己直接提供 web/dist 静态文件，只把接口反代给 Uvicorn 的这一种布局。
# 与 nginx-vestus.conf.example 的区别：那份把 / 全量反代给后端、管理端走后端的
# /admin 路由；这份的 / 是静态根目录，后端只收 /api、/uploads、/healthz。
#
# 启用前替换：admin.example.com、证书路径、VESTUS_PORT 对应的端口、静态根目录。
# 端口必须和 systemd 里 uvicorn --port 的值一致。

upstream vestus_api {
    server 127.0.0.1:18082;
    keepalive 16;
}

server {
    # 不声明 default_server，可与系统自带站点共存；若没有其他默认站点，
    # 这一段会自动成为默认，把访问裸 IP 或未知域名的请求直接断开。
    listen 80;
    listen [::]:80;
    server_name _;
    return 444;
}

server {
    listen 80;
    listen [::]:80;
    server_name admin.example.com;
    return 301 https://$host$request_uri;
}

server {
    # http2 写在 listen 上是为了兼容 Ubuntu 22.04(1.18) 和 24.04(1.24)。
    # 独立的 `http2 on;` 指令要到 nginx 1.25.1 才有，在这两个版本上会让
    # nginx -t 直接失败。
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name admin.example.com;

    ssl_certificate /etc/letsencrypt/live/admin.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/admin.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    # 即使这是唯一的 TLS 虚拟主机也要拦掉异常 Host：上传接口和平台图标的完整
    # URL 是用转发过来的 Host 拼出来的，放任伪造 Host 会污染这些地址。
    if ($host != admin.example.com) {
        return 444;
    }

    # 11m 覆盖应用默认的 10 MiB 上限加 multipart 开销。改
    # VESTUS_UPLOAD_MAX_BYTES 时这里必须同步改，否则大文件会被 Nginx 提前
    # 拦成 413，请求根本到不了应用。
    client_max_body_size 11m;

    # 管理端构建产物。Vite 没有配 base，产物按 /assets/... 引用，
    # 所以静态根必须挂在域名根目录上。
    root /opt/vestus/current/web/dist;
    index index.html;

    location / {
        # 前端没有客户端路由，兜底到 index.html 只是防止刷新出 404。
        try_files $uri $uri/ /index.html;
    }

    # 文件名带内容哈希，可以长期缓存。
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # index.html 必须不缓存，否则发新版后客户端还引用已删除的旧哈希资源。
    location = /index.html {
        add_header Cache-Control "no-store" always;
    }

    location /api/ {
        proxy_pass http://vestus_api;
        include /etc/nginx/vestus-proxy-headers.conf;
    }

    # ^~ 优先于正则 location，避免被静态资源规则截走。
    location ^~ /uploads/ {
        proxy_pass http://vestus_api;
        include /etc/nginx/vestus-proxy-headers.conf;
    }

    # 管理端仪表盘的存活探测。只回 status/database 两个字段，不含数据库地址。
    location = /healthz {
        proxy_pass http://vestus_api;
        include /etc/nginx/vestus-proxy-headers.conf;
    }

    # 交互式接口文档默认开放，生产不需要就保持这条 404。
    location = /docs { return 404; }
    location = /openapi.json { return 404; }
}
