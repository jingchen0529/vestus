# 三个反代 location 共用的头设置。安装到 /etc/nginx/vestus-proxy-headers.conf。
#
# X-Forwarded-For 故意用 $remote_addr 覆盖，不用 $proxy_add_x_forwarded_for：
# 应用在 VESTUS_TRUST_PROXY=1 时取该头的第一段作为审计日志里的客户端 IP，
# 追加模式会把客户端自带的伪造值排在前面，等于让任何人都能伪造审计 IP。

proxy_pass_request_headers on;
proxy_http_version 1.1;
# upstream 里开了 keepalive，必须清空逐跳的 Connection 头。
proxy_set_header Connection "";

proxy_set_header Host $host;
proxy_set_header X-Forwarded-Proto $scheme;
proxy_set_header X-Forwarded-Host $host;
proxy_set_header X-Forwarded-For $remote_addr;
proxy_set_header X-Real-IP $remote_addr;

proxy_connect_timeout 10s;
proxy_read_timeout 60s;
proxy_send_timeout 60s;

# 上传和下载不做缓冲改写，交给应用自己控制。
proxy_redirect off;
