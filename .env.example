# Vestus 环境变量模板 —— 复制为 .env 后按注释填值。
#
# 变量由 app/core/config.py 的 Settings 读取，统一前缀 VESTUS_（大小写不敏感）。
# 进程已有的同名环境变量优先，不会被 .env 覆盖（load_dotenv override=False）。
# 下面 replace-with-* 的占位值是故意通不过启动校验的：validate_startup_settings
# 按占位标记、长度 >= 32、字符种类 >= 10 三项拒绝，原样照抄这份文件起不来。
# 数值类变量填错不会报错，会静默回落到默认值，配错了是静悄悄生效而不是崩。
# 除 PRODUCT_NAME / UPLOAD_DIR / UPLOAD_MAX_BYTES（每次请求重读）外，改动均需重启。

# 数据库连接串（SQLAlchemy 格式），必填，未设置时启动直接失败。不要提交真实凭据。
VESTUS_DATABASE_URL=mysql+pymysql://vestus:change-me@127.0.0.1:3306/vestus?charset=utf8mb4
# 1 表示 MySQL 连不上时自动降级到 SQLite。仅本地救急，线上保持 0。
VESTUS_SQLITE_FALLBACK=0
# 首个超级管理员（role=super_admin）。启动时同名账号不存在才创建，存在则跳过，
# 改这里的密码不会重置已有账号的密码。密码留空则整个引导流程跳过。
VESTUS_BOOTSTRAP_ADMIN_USERNAME=admin
# 校验：不得是占位值，长度 >= 8。
VESTUS_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-random-password
# 令牌签名密钥，同时是代理密码加解密的兜底密钥。用 `openssl rand -hex 32` 生成。
# 换值有两重后果：已签发的令牌全部失效，且库里已加密的代理密码解不开，
# 只能在后台逐条重新保存密码。多 worker 部署必须共用同一个值。
VESTUS_SECRET_KEY=replace-with-a-long-random-secret
# 代理密码专用加密密钥，不设则复用 VESTUS_SECRET_KEY。
# 设了就走同样的强校验；单独配它的好处是轮换令牌密钥时不牵连已存的代理凭据。
VESTUS_PROXY_SECRET_KEY=replace-with-a-separate-long-random-secret
# 访问令牌有效期（秒）。900 = 15 分钟，也是代码默认值。
VESTUS_ACCESS_TOKEN_TTL_SECONDS=900
# 允许的跨域来源，逗号分隔。5174 是 web/vite.config.ts 里固定的开发端口。
# 生产由反向代理同源转发 /api、/uploads、/healthz，通常不需要配。
VESTUS_CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
# 1 表示 Cookie 只走 HTTPS。线上必须置 1。
VESTUS_COOKIE_SECURE=0
# 产品名回落值，不是最终来源：数据库 settings 表的 product_name 配了就优先。
# 空值、超过 100 字符或含不可打印字符时回落到 "Vestus"。
VESTUS_PRODUCT_NAME=Vestus
# 上传目录，相对路径按仓库根目录解析。
VESTUS_UPLOAD_DIR=uploads
# 单文件上限，10485760 = 10 MiB。
VESTUS_UPLOAD_MAX_BYTES=10485760

# --- 其余可选项，Settings 认但模板此前没列，需要时取消注释 ---
# VESTUS_SQLITE_PATH=                     # 降级用的库文件路径，默认仓库根目录 vestus-dev.db
# VESTUS_LOGIN_MAX_ATTEMPTS=5             # 登录失败锁定阈值
# VESTUS_LOGIN_LOCK_MINUTES=15            # 锁定时长（分钟）
# VESTUS_BOOTSTRAP_ADMIN_NAME=系统管理员    # 引导管理员的显示名
#
# 兼容旧部署的别名，新配置不要用：VESTUS_JWT_SECRET 之于 VESTUS_SECRET_KEY，
# VESTUS_ADMIN_USERNAME / VESTUS_ADMIN_PASSWORD 之于对应的 BOOTSTRAP_ 变量。
