{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "桌面登录与平台选择主窗口所需的核心权限",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-close",
    "core:window:allow-set-theme",
    "core:window:allow-start-dragging",
    "core:app:allow-set-app-theme"
  ]
}
